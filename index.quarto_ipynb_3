        "## Populism by country, 2018"
      ],
      "id": "5c9b2441"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| echo: false\n",
        "#| output: asis\n",
        "\n",
        "# Pulled live from the published index every time this site is built --\n",
        "# NOT hand-copied numbers. If this table ever looks out of sync with\n",
        "# data/2025/output/index_2025.csv, that means the site needs rebuilding,\n",
        "# not that the numbers need editing here.\n",
        "df = pd.read_csv(\"data/2025/output/index_2025.csv\")\n",
        "\n",
        "FEATURED_YEAR = 2018  # matches the year discussed in the Documentation page narrative\n",
        "\n",
        "year_data = df[(df[\"YEAR\"] == FEATURED_YEAR) & (df[\"POP\"].notna())].copy()\n",
        "year_data = year_data.sort_values(\"POP\", ascending=False).reset_index(drop=True)\n",
        "\n",
        "rows_html = []\n",
        "for i, r in year_data.iterrows():\n",
        "    rank = i + 1\n",
        "    flag_url = f\"https://flagcdn.com/w40/{r['ISO2'].lower()}.png\"\n",
        "    rows_html.append(f\"\"\"    <tr>\n",
        "      <td><div class=\"country\"><img class=\"flag\" src=\"{flag_url}\" alt=\"{r['COUNTRY']} flag\">{r['COUNTRY']}</div></td>\n",
        "      <td>{r['POP']:.1f} ({rank})</td>\n",
        "      <td>{r['EP']:.1f}</td>\n",
        "      <td>{r['IP']:.1f}</td>\n",
        "      <td>{r['POP_R']:.2f}</td>\n",
        "    </tr>\"\"\")\n",
        "\n",
        "table_html = f\"\"\"<table class=\"lallpi-ranking\">\n",
        "  <thead>\n",
        "    <tr>\n",
        "      <th>Country</th>\n",
        "      <th>Overall populism</th>\n",
        "      <th>Economic populism</th>\n",
        "      <th>Institutional populism</th>\n",
        "      <th>Populist rhetoric</th>\n",
        "    </tr>\n",
        "  </thead>\n",
        "  <tbody>\n",
        "{chr(10).join(rows_html)}\n",
        "  </tbody>\n",
        "</table>\"\"\"\n",
        "\n",
        "print(table_html)"
      ],
