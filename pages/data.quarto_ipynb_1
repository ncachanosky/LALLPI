        "\n",
        "# Pulled live from the published index -- see index.qmd for why this\n",
        "# matters (the old site's \"21 countries, 2002-2019\" text had gone\n",
        "# stale relative to the actual data).\n",
        "import pandas as pd\n",
        "\n",
        "df = pd.read_csv(\"data/2025/output/index_2025.csv\")\n",
        "n_countries = df[\"ISO3\"].nunique()\n",
        "year_min, year_max = df[\"YEAR\"].min(), df[\"YEAR\"].max()\n",
        "\n",
        "print(f\"- **Countries covered:** {n_countries}\")\n",
        "print(f\"- **Years covered:** {year_min}-{year_max}\")"
